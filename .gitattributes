* text=auto
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
# Patch context can intentionally contain CRLF from upstream DOS sources.
*.patch -text
*.json text eol=lf
*.BAT text eol=crlf
*.bin binary
*.EXE binary
*.COM binary
*.DOS binary
*.ZIP binary
# Preserve vendor bytes and their recorded hashes, including CRLF text files.
assets/windows-drivers/video/** -text
assets/windows-drivers/audio/** -text
