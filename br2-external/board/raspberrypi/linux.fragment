# Shared BCM2837/BCM2711/BCM2712 hardware baseline; boot essentials are built-in.
# CONFIG_MODULES is not set
CONFIG_ARM64_4K_PAGES=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_INPUT_EVDEV=y
# Wired controllers use kernel evdev drivers; keep these independent of defconfig.
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_HID_SONY=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HID_NINTENDO=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_DWCOTG=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=y
CONFIG_USB_DWC3=y
CONFIG_USB_HID=y
# USB floppy drives use the USB mass-storage UFI transport and SCSI disk API.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
# USB CD/DVD/BD units expose their CD media through the SCSI CD-ROM driver.
CONFIG_BLK_DEV_SR=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_HID_GENERIC=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_BRCMSTB=y
CONFIG_MMC_BCM2835=y
CONFIG_MMC_BCM2835_MMC=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_PCIE_BRCMSTB=y
CONFIG_MFD_RP1=y
CONFIG_PINCTRL_RP1=y
CONFIG_PINCTRL_BCM2712=y
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y
CONFIG_DRM_DISPLAY_CONNECTOR=y
CONFIG_DRM_SIMPLE_BRIDGE=y
CONFIG_DRM_RP1_DPI=y
CONFIG_DRM_LOAD_EDID_FIRMWARE=y
CONFIG_SND=y
CONFIG_SND_PROC_FS=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_HDMI_CODEC=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_RAWMIDI=y
CONFIG_SND_SEQUENCER=y
CONFIG_SND_SEQ_MIDI=y
CONFIG_UNIX=y
# Wired IPv4 networking for DHCP and network time; netlink also serves libudev-zero.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_BCMGENET=y
CONFIG_NET_VENDOR_CADENCE=y
CONFIG_MACB=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_LAN78XX=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_DRV_RPI=y
# CONFIG_IPV6 is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_RFKILL is not set
# CONFIG_KVM is not set
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_LOGO is not set
# Distribution defconfig modules become built-ins when MODULES is disabled.
# Exclude unrelated top-level groups rather than embedding camera/TV drivers
# and general-purpose filesystems in the appliance kernel.
# CONFIG_MEDIA_SUPPORT is not set
# The Pi 3/4 analogue jack driver lives under staging in the pinned kernel.
CONFIG_STAGING=y
CONFIG_BCM_VIDEOCORE=y
CONFIG_BCM2835_VCHIQ=y
CONFIG_SND_BCM2835=y
# CONFIG_VCHIQ_CDEV is not set
# CONFIG_FB_TFT is not set
# CONFIG_IIO is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_BCACHEFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_NTFS_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_CEPH_FS is not set
# CONFIG_9P_FS is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_BINFMT_MISC is not set
CONFIG_LOCALVERSION="-pi-dos-arm64"
# CONFIG_LOCALVERSION_AUTO is not set
