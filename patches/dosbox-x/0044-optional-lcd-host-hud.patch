 static SDL_Surface *pidos_lcd_surface = nullptr;
 static SDL_Surface *pidos_lcd_linear_surface = nullptr;
 static bool pidos_lcd_linear = false;
+#if defined(__linux__)
+/* The SDL owner manages the overlay; the monitor only reads Linux files. */
+static PidosHud *pidos_hud = nullptr;
+static bool pidos_hud_presented = false;
+static void pidos_hud_stop() { delete pidos_hud; pidos_hud=nullptr; pidos_hud_presented=false; }
+static void pidos_hud_start() {
+    const char *enabled=getenv("PI_DOS_LCD_HUD");
+    if (!enabled || strcmp(enabled,"true")) return;
+    pidos_hud=new (std::nothrow) PidosHud();
+    if (pidos_hud && !pidos_hud->start()) pidos_hud_stop();
+}
+void OUTPUT_SURFACE_PiDosHudPump() {
+    if (pidos_hud && pidos_hud_presented && !sdl.updating && pidos_lcd_surface &&
+        sdl.window && sdl.surface && pidos_hud->pulse_due()) {
+        if (pidos_hud->draw(sdl.surface)) SDL_UpdateWindowSurface(sdl.window);
+    }
+}
+#endif
