+bool CPU_PiDosSetCycles(const std::string &cycles) {
+    Section_prop *section=static_cast<Section_prop *>(control->GetSection("cpu"));
+    if(!section->Get_prop("cycles")->SetValue(cycles)) return false;
+    CPU_AutoDetermineMode &= ~CPU_AUTODETERMINE_CYCLES;
+    CPU_CycleLeft=0; CPU_Cycles=0; CPU_SkipCycleAutoAdjust=false;
+    CPU_ApplyCycleConfig(section);
+    if(CPU_CycleMax<=0) CPU_CycleMax=3000;
+    if(!CPU_CycleAutoAdjust && !(CPU_AutoDetermineMode&CPU_AUTODETERMINE_CYCLES)) CPU_CyclesSet=CPU_CycleMax;
+    GFX_SetTitle((int32_t)(CPU_CycleAutoAdjust?CPU_CyclePercUsed:CPU_CycleMax),-1,-1,false);
+    return true;
+}
