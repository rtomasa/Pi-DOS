; Names of the disks Setup can prompt for.

[disks]
    t =., "ET4000 Windows 3.1 Driver Disk", diskt

[display]
;profile = driver,      Description of driver,                       resolution,    286 grabber,    logo code,     VDD,           386grabber,   ega.sys,   logo data,     optional work section
svga444 = t:vga4l4.drv, "ET4000  640x480     16 col.",               "100,96,96",   t:vgacolrx.gr2, t:vgalogo.lgo, t:vddtli4.386, t:v7vga.3gr,,            t:vgalogo.rle
